
<%- include('partials/header') %>

<style>
    .bookings-admin-page {
        max-width: 1400px;
        width: 92%;
        margin: 0 auto;
        padding: 2.5rem 0 4rem;
        color: #0a2544;
        background: #f5f6f7;
    }

    /* Dashboard header */
    .bookings-hero {
        background: #ffffff;
        color: #0a2544;
        padding: 2.5rem;
        border-radius: 12px;
        margin-bottom: 2rem;
        border: 1px solid #e3e7eb;
        border-left: 5px solid #f4c542;
    }

    .bookings-hero-content {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1.5rem;
        flex-wrap: wrap;
    }

    .bookings-hero h1 {
        color: #123c69;
        font-size: clamp(1.8rem, 4vw, 2.5rem);
        margin: 0 0 0.6rem;
    }

    .bookings-hero p {
        margin: 0;
        color: #52677b;
        line-height: 1.6;
    }

    .bookings-hero-label {
        display: inline-block;
        margin-bottom: 0.8rem;
        color: #123c69;
        font-size: 0.8rem;
        font-weight: 700;
        letter-spacing: 0.12em;
        text-transform: uppercase;
    }

    /* Refresh button */
    .bookings-refresh {
        background: #f4c542;
        color: #0a2544;
        border: 1px solid #e0b52e;
        border-radius: 8px;
        padding: 0.85rem 1.2rem;
        font-size: 0.95rem;
        font-weight: 700;
        cursor: pointer;
        transition: background 0.2s, transform 0.2s;
    }

    .bookings-refresh:hover {
        background: #e8b92e;
        transform: translateY(-2px);
    }

    .bookings-refresh:disabled {
        opacity: 0.6;
        cursor: wait;
        transform: none;
    }

    /* Statistics */
    .bookings-overview {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 1.2rem;
        margin-bottom: 2rem;
    }

    .bookings-stat-card {
        background: #ffffff;
        border: 1px solid #e3eaf0;
        border-radius: 12px;
        padding: 1.5rem;
        box-shadow: 0 4px 16px rgba(10, 37, 68, 0.04);
    }

    .bookings-stat-label {
        display: block;
        color: #64778a;
        font-size: 0.9rem;
        margin-bottom: 0.7rem;
    }

    .bookings-stat-value {
        display: block;
        color: #123c69;
        font-size: 2rem;
        font-weight: 800;
    }

    /* Bookings section */
    .bookings-section {
        background: #ffffff;
        border: 1px solid #e3eaf0;
        border-radius: 14px;
        overflow: hidden;
        box-shadow: 0 5px 20px rgba(10, 37, 68, 0.05);
    }

    .bookings-section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 1rem;
        flex-wrap: wrap;
        padding: 1.5rem;
        border-bottom: 1px solid #e8edf2;
    }

    .bookings-section-header h2 {
        color: #123c69;
        font-size: 1.25rem;
        margin: 0 0 0.35rem;
    }

    .bookings-section-header p {
        color: #718096;
        font-size: 0.9rem;
        margin: 0;
    }

    /* Search */
    .bookings-search {
        width: min(100%, 300px);
        padding: 0.8rem 1rem;
        border: 1px solid #d6e0e9;
        border-radius: 8px;
        font: inherit;
        outline: none;
        background: #ffffff;
        color: #0a2544;
    }

    .bookings-search:focus {
        border-color: #123c69;
        box-shadow: 0 0 0 3px rgba(18, 60, 105, 0.1);
    }

    /* Table */
    .bookings-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .bookings-table {
        width: 100%;
        min-width: 850px;
        border-collapse: collapse;
        text-align: left;
    }

    .bookings-table th {
        background: #f3f6f9;
        color: #52677b;
        font-size: 0.78rem;
        font-weight: 700;
        letter-spacing: 0.05em;
        text-transform: uppercase;
        padding: 1rem 1.2rem;
        white-space: nowrap;
    }

    .bookings-table td {
        padding: 1.15rem 1.2rem;
        border-bottom: 1px solid #edf1f5;
        color: #40566b;
        font-size: 0.9rem;
    }

    .bookings-table tbody tr:hover {
        background: #faf9f4;
    }

    .bookings-table tbody tr:last-child td {
        border-bottom: none;
    }

    .booking-reference {
        color: #123c69;
        font-weight: 800;
    }

    .booking-ticket {
        display: inline-block;
        background: #fff7dc;
        color: #765600;
        padding: 0.4rem 0.65rem;
        border-radius: 6px;
        font-size: 0.8rem;
        font-weight: 700;
    }

    .booking-actions {
        display: flex;
        gap: 0.5rem;
        white-space: nowrap;
    }

    .booking-action {
        border: 1px solid #cbd6e0;
        border-radius: 6px;
        padding: 0.5rem 0.7rem;
        background: #ffffff;
        color: #123c69;
        font: inherit;
        cursor: pointer;
    }

    .booking-action-delete {
        color: #a12b2b;
        border-color: #e6bcbc;
    }

    .booking-action:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    .bookings-feedback {
        margin: 0 0 1rem;
        padding: 0.9rem 1rem;
        border-radius: 8px;
        color: #155d36;
        background: #eef9f1;
        border: 1px solid #b9e2c6;
    }

    .bookings-feedback[data-kind="error"] {
        color: #8d2424;
        background: #fff2f2;
        border-color: #f3cccc;
    }

    .booking-editor {
        width: min(720px, calc(100% - 2rem));
        max-height: 90vh;
        padding: 0;
        border: 0;
        border-radius: 14px;
        color: #0a2544;
        box-shadow: 0 20px 70px rgba(10, 37, 68, 0.3);
    }

    .booking-editor::backdrop {
        background: rgba(10, 37, 68, 0.55);
    }

    .booking-editor-content {
        padding: 1.5rem;
        overflow-y: auto;
        max-height: 90vh;
    }

    .booking-editor-header {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 1rem;
        margin-bottom: 1rem;
    }

    .booking-editor-header h2 {
        margin: 0;
        color: #123c69;
    }

    .booking-editor-close {
        border: 0;
        background: transparent;
        color: #52677b;
        font-size: 1.5rem;
        line-height: 1;
        cursor: pointer;
    }

    .booking-editor-form,
    .booking-editor-fields {
        display: grid;
        gap: 1rem;
    }

    .booking-editor-fields {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .booking-editor label,
    .booking-passenger label {
        display: grid;
        gap: 0.35rem;
        color: #40566b;
        font-weight: 600;
    }

    .booking-editor select,
    .booking-passenger input {
        width: 100%;
        min-height: 44px;
        padding: 0.65rem 0.75rem;
        border: 1px solid #cbd6e0;
        border-radius: 6px;
        background: #ffffff;
        color: #0a2544;
        font: inherit;
    }

    .booking-editor :focus-visible,
    .booking-action:focus-visible,
    .bookings-refresh:focus-visible {
        outline: 3px solid #477fbd;
        outline-offset: 2px;
    }

    .booking-passengers {
        display: grid;
        gap: 0.8rem;
        padding: 0;
        border: 0;
    }

    .booking-passengers > legend {
        margin-bottom: 0.75rem;
        color: #123c69;
        font-weight: 700;
    }

    .booking-passenger {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.8rem;
        padding: 1rem;
        border: 1px solid #e3eaf0;
        border-radius: 8px;
    }

    .booking-passenger legend {
        padding: 0 0.4rem;
        color: #52677b;
        font-weight: 700;
    }

    .booking-passenger-remove {
        justify-self: start;
        border: 0;
        padding: 0.3rem 0;
        color: #a12b2b;
        background: transparent;
        font: inherit;
        text-decoration: underline;
        cursor: pointer;
    }

    .booking-editor-error {
        padding: 0.8rem;
        color: #8d2424;
        background: #fff2f2;
        border: 1px solid #f3cccc;
        border-radius: 6px;
    }

    .booking-editor-footer {
        display: flex;
        justify-content: flex-end;
        flex-wrap: wrap;
        gap: 0.7rem;
        padding-top: 0.5rem;
    }

    .booking-editor-footer button,
    .booking-add-passenger {
        min-height: 42px;
        padding: 0.65rem 1rem;
        border: 1px solid #cbd6e0;
        border-radius: 7px;
        background: #ffffff;
        color: #123c69;
        font: inherit;
        font-weight: 700;
        cursor: pointer;
    }

    .booking-editor-footer .booking-save {
        border-color: #e0b52e;
        background: #f4c542;
        color: #0a2544;
    }

    .booking-editor-footer button:disabled,
    .booking-add-passenger:disabled {
        opacity: 0.6;
        cursor: wait;
    }

    /* Loading, empty and error states */
    .bookings-state {
        padding: 3rem 1.5rem;
        text-align: center;
        color: #64778a;
    }

    .bookings-state h3 {
        color: #123c69;
        font-size: 1.1rem;
        margin: 0 0 0.5rem;
    }

    .bookings-state p {
        margin: 0;
        line-height: 1.6;
    }

    .bookings-error {
        color: #a12b2b;
        background: #fff2f2;
        border: 1px solid #f3cccc;
        border-radius: 8px;
        margin: 1.5rem;
        padding: 1.2rem;
        text-align: center;
    }

    .bookings-error h3 {
        margin: 0 0 0.5rem;
    }

    .bookings-error button {
        margin-top: 0.8rem;
        padding: 0.6rem 1rem;
        border: none;
        border-radius: 6px;
        background: #a12b2b;
        color: #ffffff;
        cursor: pointer;
    }

    .bookings-updated {
        color: #718096;
        font-size: 0.8rem;
        padding: 1rem 1.5rem;
        border-top: 1px solid #edf1f5;
        margin: 0;
    }

    [hidden] {
        display: none !important;
    }

    /* Mobile layout */
    @media (max-width: 650px) {
        .bookings-admin-page {
            width: 94%;
            padding-top: 1.5rem;
        }

        .bookings-hero {
            padding: 1.6rem;
        }

        .bookings-hero-content {
            align-items: flex-start;
        }

        .bookings-refresh {
            width: 100%;
        }

        .bookings-overview {
            grid-template-columns: 1fr;
            gap: 0.8rem;
        }

        .bookings-stat-card {
            padding: 1.2rem;
        }

        .bookings-section-header {
            padding: 1.2rem;
        }

        .bookings-search {
            width: 100%;
        }

        .bookings-table {
            min-width: 760px;
        }

        .booking-editor-content {
            padding: 1rem;
        }

        .booking-editor-fields,
        .booking-passenger {
            grid-template-columns: 1fr;
        }

        .booking-editor-footer {
            display: grid;
            grid-template-columns: 1fr;
        }

        .booking-editor-footer button {
            width: 100%;
        }
    }
</style>

<main class="bookings-admin-page">
    <div
        id="bookings-feedback"
        class="bookings-feedback"
        role="status"
        aria-live="polite"
        hidden
    ></div>

    <!-- Dashboard heading -->
    <section class="bookings-hero">
        <div class="bookings-hero-content">
            <div>
                <span class="bookings-hero-label">
                    Kizuna Rail Administration
                </span>

                <h1><%= title %></h1>

                <p>
                    Monitor reservations and passenger information
                    across your railway journeys.
                </p>
            </div>

            <button
                type="button"
                class="bookings-refresh"
                id="bookings-refresh"
            >
                Refresh Bookings
            </button>
        </div>
    </section>

    <!-- Booking statistics -->
    <section
        class="bookings-overview"
        aria-label="Booking statistics"
    >
        <article class="bookings-stat-card">
            <span class="bookings-stat-label">
                Total Bookings
            </span>

            <strong
                class="bookings-stat-value"
                id="bookings-count"
            >
                0
            </strong>
        </article>

        <article class="bookings-stat-card">
            <span class="bookings-stat-label">
                Total Passengers
            </span>

            <strong
                class="bookings-stat-value"
                id="passengers-count"
            >
                0
            </strong>
        </article>
    </section>

    <!-- Bookings records -->
    <section class="bookings-section">

        <header class="bookings-section-header">
            <div>
                <h2>Booking Records</h2>

                <p>
                    Review reservations and their travel details.
                </p>
            </div>

            <input
                type="search"
                id="bookings-search"
                class="bookings-search"
                placeholder="Search bookings..."
                aria-label="Search bookings"
            >
        </header>

        <!-- Loading state -->
        <div
            id="bookings-loading"
            class="bookings-state"
            role="status"
        >
            <h3>Loading bookings</h3>
            <p>
                Please wait while we retrieve the reservation records.
            </p>
        </div>

        <!-- Error state -->
        <div
            id="bookings-error"
            class="bookings-error"
            role="alert"
            hidden
        >
            <h3>Unable to load bookings</h3>

            <p id="bookings-error-message">
                Something went wrong while retrieving the reservation records.
            </p>

            <button type="button" id="bookings-retry">
                Try Again
            </button>
        </div>

        <!-- Empty state -->
        <div
            id="bookings-empty"
            class="bookings-state"
            hidden
        >
            <h3>No bookings yet</h3>

            <p>
                New reservations will appear here when customers make bookings.
            </p>
        </div>

        <!-- Search empty state -->
        <div
            id="bookings-no-results"
            class="bookings-state"
            hidden
        >
            <h3>No matching bookings</h3>

            <p>
                Try searching with a different booking reference or trip ID.
            </p>
        </div>

        <!-- Dynamic bookings table -->
        <div class="bookings-table-wrapper">
            <table
                class="bookings-table"
                id="bookings-table"
                hidden
            >
                <thead>
                    <tr>
                        <th>Booking Reference</th>
                        <th>Trip</th>
                        <th>Schedule</th>
                        <th>Ticket Class</th>
                        <th>Travel Day</th>
                        <th>Passengers</th>
                        <th>Booking Date</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody id="bookings-list"></tbody>
            </table>
        </div>

        <p
            class="bookings-updated"
            id="bookings-updated"
            hidden
        ></p>

    </section>
</main>

<!-- Booking row template -->
<template id="booking-row-template">
    <tr>
        <td>
            <span
                class="booking-reference"
                data-field="id"
            ></span>
        </td>

        <td data-field="trip"></td>

        <td data-field="schedule"></td>

        <td>
            <span
                class="booking-ticket"
                data-field="ticket-class"
            ></span>
        </td>

        <td data-field="travel-day"></td>

        <td data-field="passengers"></td>

        <td data-field="created-at"></td>

        <td>
            <div class="booking-actions">
                <button
                    type="button"
                    class="booking-action"
                    data-action="edit"
                >
                    Edit
                </button>
                <button
                    type="button"
                    class="booking-action booking-action-delete"
                    data-action="delete"
                >
                    Delete
                </button>
            </div>
        </td>
    </tr>
</template>

<dialog
    id="booking-editor-dialog"
    class="booking-editor"
    aria-labelledby="booking-editor-title"
>
    <div class="booking-editor-content">
        <div class="booking-editor-header">
            <div>
                <h2 id="booking-editor-title">Edit booking</h2>
                <p id="booking-editor-reference"></p>
            </div>
            <button
                type="button"
                class="booking-editor-close"
                id="booking-editor-close"
                aria-label="Close booking editor"
            >
                &times;
            </button>
        </div>

        <p
            id="booking-editor-error"
            class="booking-editor-error"
            role="alert"
            hidden
        ></p>

        <form id="booking-editor-form" class="booking-editor-form">
            <div class="booking-editor-fields">
                <label for="booking-trip">Trip
                    <select id="booking-trip" name="tripId" required></select>
                </label>

                <label for="booking-schedule">Schedule
                    <select id="booking-schedule" name="scheduleId" required></select>
                </label>

                <label for="booking-ticket-class">Ticket class
                    <select id="booking-ticket-class" name="ticketClass" required></select>
                </label>

                <label for="booking-travel-day">Selected travel day
                    <select id="booking-travel-day" name="selectedDay" required></select>
                </label>
            </div>

            <fieldset class="booking-passengers">
                <legend>Passengers (1–8)</legend>
                <div id="booking-passengers-list"></div>
                <button
                    type="button"
                    class="booking-add-passenger"
                    id="booking-add-passenger"
                >
                    Add passenger
                </button>
            </fieldset>

            <div class="booking-editor-footer">
                <button type="button" id="booking-editor-cancel">Cancel</button>
                <button type="submit" class="booking-save" id="booking-save">
                    Save changes
                </button>
            </div>
        </form>
    </div>
</dialog>

<script src="/js/bookings-admin.js" defer></script>

<%- include('partials/footer') %>
