<%- include('../partials/header') %>

<article class="route-detail">
    <div class="route-header">
        <div class="route-header-content">
            <h1 class="route-name"><%= details.name %></h1>
            <p class="route-description"><%= details.description %></p>
            
            <% if (details.highlights && details.highlights.length > 0) { %>
            <div class="highlights">
                <% details.highlights.forEach(function(highlight) { %>
                <span class="highlight-tag"><%= highlight %></span>
                <% }); %>
            </div>
            <% } %>
        </div>
        
        <% if (details.imageUrl) { %>
        <div class="route-image">
            <img src="<%= details.imageUrl %>" alt="<%= details.name %>">
        </div>
        <% } %>
    </div>

    <div class="route-info">
        <div class="info-grid">
            <div class="info-item">
                <span class="info-label">Region</span>
                <span class="info-value region-<%= details.region %>"><%= details.region.charAt(0).toUpperCase() + details.region.slice(1) %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Duration</span>
                <span class="info-value"><%= details.duration %></span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Distance</span>
                <span class="info-value"><%= details.distance %> km</span>
            </div>
            
            <div class="info-item">
                <span class="info-label">Best Season</span>
                <span class="info-value season-<%= details.bestSeason %>"><%= details.bestSeason.charAt(0).toUpperCase() + details.bestSeason.slice(1) %></span>
            </div>
        </div>

        <div class="route-stations">
            <h2>Trip</h2>
            <div class="stations">
                <div class="station">
                    <span class="station-label">Start</span>
                    <span class="station-name"><%= details.startStation.charAt(0).toUpperCase() + details.startStation.slice(1) %></span>
                </div>
                <div class="station">
                    <span class="station-label">End</span>
                    <span class="station-name"><%= details.endStation.charAt(0).toUpperCase() + details.endStation.slice(1) %></span>
                </div>
            </div>
        </div>

        <div class="route-operating">
            <h2>Operating Schedule</h2>
            <div class="months-grid">
                <% details.operatingMonths.forEach(function(month) { %>
                <span class="month-badge"><%= month %></span>
                <% }); %>
            </div>
        </div>

        <div class="route-schedules">
            <h2>Available Schedules</h2>
            <label for="schedule-month">Month</label>
            <select id="schedule-month">
                <option value="">All operating months</option>
                <% details.operatingMonths.forEach(function(month) { %>
                <option value="<%= month %>"><%= new Date(2000, month - 1).toLocaleString('en', { month: 'long' }) %></option>
                <% }); %>
            </select>
            <p id="schedule-status" aria-live="polite">Loading schedules...</p>
            <div id="schedules-grid" class="schedules-grid" data-trip-id="<%= details.id %>"></div>
        </div>
    </div>
</article>

<script>
    const monthSelector = document.getElementById('schedule-month');
    const schedulesGrid = document.getElementById('schedules-grid');
    const scheduleStatus = document.getElementById('schedule-status');

    function showScheduleMessage(message) {
        scheduleStatus.textContent = message;
        schedulesGrid.replaceChildren();
    }

    function createScheduleCard(schedule) {
        const card = document.createElement('div');
        card.className = 'schedule-card';

        const times = document.createElement('div');
        times.className = 'schedule-times';
        for (const [label, time] of [
            ['Departs', schedule.departureTime],
            ['Arrives', schedule.arrivalTime]
        ]) {
            const block = document.createElement('div');
            block.className = 'time-block';
            const timeLabel = document.createElement('span');
            timeLabel.className = 'time-label';
            timeLabel.textContent = label;
            const timeValue = document.createElement('span');
            timeValue.className = 'time-value';
            timeValue.textContent = time;
            block.append(timeLabel, timeValue);
            times.append(block);
            if (label === 'Departs') {
                const arrow = document.createElement('span');
                arrow.className = 'time-arrow';
                arrow.textContent = '→';
                times.append(arrow);
            }
        }
        card.append(times);

        const days = document.createElement('div');
        days.className = 'schedule-days';
        for (const day of schedule.daysOfWeek) {
            const badge = document.createElement('span');
            badge.className = 'day-badge';
            badge.textContent = day.substring(0, 3);
            days.append(badge);
        }
        card.append(days);

        const bookingLink = document.createElement('a');
        bookingLink.className = 'book-btn';
        bookingLink.href = `/trips/booking/${encodeURIComponent(schedule.id)}`;
        bookingLink.textContent = 'Book Now';
        card.append(bookingLink);

        return card;
    }

    async function loadSchedules() {
        const month = monthSelector.value;
        const tripId = schedulesGrid.dataset.tripId;
        const monthQuery = month ? `?month=${encodeURIComponent(month)}` : '';
        scheduleStatus.textContent = 'Loading schedules...';

        try {
            const response = await fetch(
                `/api/trips/${encodeURIComponent(tripId)}/schedules${monthQuery}`
            );
            const schedules = await response.json();

            if (response.status === 404) {
                showScheduleMessage('No schedules available for this month.');
                return;
            }
            if (!response.ok) {
                throw new Error(schedules.error || 'Unable to load schedules.');
            }

            schedulesGrid.replaceChildren(...schedules.map(createScheduleCard));
            scheduleStatus.textContent = schedules.length
                ? ''
                : 'No schedules available for this month.';
        } catch (error) {
            showScheduleMessage(error.message);
        }
    }

    monthSelector.addEventListener('change', loadSchedules);
    loadSchedules();
</script>

<%- include('../partials/footer') %>