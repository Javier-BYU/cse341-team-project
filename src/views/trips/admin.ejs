
<%- include('../partials/header') %>

<section class="trip-admin">
    <header class="trip-admin-header">
        <div>
            <h1>Manage Trips</h1>
            <p>View, update and delete existing scenic train trips.</p>
        </div>
        <a href="/admin" class="back-link">Back to Admin Dashboard</a>
    </header>

    <p id="trip-admin-message" class="trip-admin-message" role="status" aria-live="polite"></p>

    <section class="trip-admin-list-section">
        <h2>Existing Trips</h2>
        <p id="trip-admin-loading">Loading trips...</p>
        <div id="trip-admin-list"></div>
    </section>

    <section class="trip-admin-editor" id="trip-admin-editor" hidden>
        <h2>Edit Trip</h2>

        <form id="trip-admin-form">
            <input type="hidden" id="trip-id">

            <div class="trip-admin-field">
                <label for="trip-name">Trip name</label>
                <input type="text" id="trip-name" required>
            </div>

            <div class="trip-admin-field">
                <label for="trip-description">Description</label>
                <textarea id="trip-description" required></textarea>
            </div>

            <div class="trip-admin-field">
                <label for="trip-region">Region</label>
                <input type="text" id="trip-region" required>
            </div>

            <div class="trip-admin-field">
                <label for="trip-start">Starting station</label>
                <select id="trip-start" required></select>
            </div>

            <div class="trip-admin-field">
                <label for="trip-end">Ending station</label>
                <select id="trip-end" required></select>
            </div>

            <div class="trip-admin-field">
                <label for="trip-duration">Duration</label>
                <input type="text" id="trip-duration" required>
            </div>

            <div class="trip-admin-field">
                <label for="trip-distance">Distance (km)</label>
                <input type="number" id="trip-distance" min="0" step="0.1" required>
            </div>

            <div class="trip-admin-field">
                <label for="trip-highlights">Highlights (one per line)</label>
                <textarea id="trip-highlights" required></textarea>
            </div>

            <div class="trip-admin-field">
                <label for="trip-season">Best season</label>
                <input type="text" id="trip-season" required>
            </div>

            <div class="trip-admin-field">
                <label for="trip-months">Operating months (comma-separated numbers 1–12)</label>
                <input type="text" id="trip-months" required>
            </div>

            <div class="trip-admin-field">
                <label for="trip-image">Image URL</label>
                <input type="url" id="trip-image">
            </div>

            <fieldset class="trip-admin-field">
                <legend>Existing schedules</legend>
                <p>Select the schedules that should belong to this trip.</p>
                <div id="trip-schedules"></div>
            </fieldset>

            <div class="trip-admin-actions">
                <button type="submit">Save Changes</button>
                <button type="button" id="trip-admin-cancel">Cancel</button>
            </div>
        </form>
    </section>
</section>

<script src="/js/trip-admin.js" defer></script>

<%- include('../partials/footer') %>
