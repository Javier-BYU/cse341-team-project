<%- include('../partials/header') %>
<h1><%- title %></h1>

<div id="filters">
    <label for="region-filter">Search by Region:</label>
    <select id="region-filter">
        <option value="all">All Regions</option>
    </select>

    <label for="season-filter">Search by Season:</label>
    <select id="season-filter">
        <option value="all">Any Season</option>
    </select>

    <label for="trip-search">Search trips:</label>
    <input id="trip-search" type="search" placeholder="Name or description">
</div>

<div class="routes-grid" id="trips-list"></div>
<p id="trips-empty" role="status" hidden>No trips found</p>
<nav id="trips-pagination" aria-label="Trip list pagination">
    <button id="trips-previous" type="button" disabled>Previous</button>
    <span id="trips-page-indicator" aria-live="polite">Page 1 of 1</span>
    <button id="trips-next" type="button" disabled>Next</button>
</nav>
<div id="trips-error" hidden>Unable to load trips. Please try again later.</div>

<template id="trip-card-template">
    <div class="route-card">
        <div class="route-header">
            <h2 class="route-name" data-field="name"></h2>
            <span class="route-region" data-field="region"></span>
        </div>
        <div class="station-info">
            <div class="station"><div class="station-type">From:</div><div class="station-name" data-field="start"></div></div>
            <div class="route-arrow">&#8594;</div>
            <div class="station"><div class="station-type">To:</div><div class="station-name" data-field="end"></div></div>
        </div>
        <div class="route-details">
            <div class="detail-item"><span class="detail-icon">&#128337;</span><span><span class="detail-label">Duration:</span> <span data-field="duration"></span></span></div>
            <div class="detail-item"><span class="detail-icon">&#128205;</span><span><span class="detail-label">Distance:</span> <span data-field="distance"></span>km</span></div>
            <div class="detail-item"><span class="season-badge" data-field="season"></span></div>
        </div>
        <div class="route-description" data-field="description"></div>
        <div class="highlights"><div class="highlights-list" data-field="highlights"></div></div>
        <div class="route-actions"><a class="view-details-btn" data-field="details">View Details &amp; Book &#8594;</a></div>
    </div>
</template>

<%- include('../partials/footer') %>
